{
  "name": "spx-service",
  "version": "1.0.0",
  "private": true,
  "description": "SpiderX backend API. Mirrors the uiServices architecture: Express + TypeScript over HTTPS on :8082.",
  "main": "dist/app.js",
  "scripts": {
    "dev": "NODE_ENV=development ts-node-dev --respawn --clear --transpile-only --ignore-watch node_modules ./src/app.ts",
    "build": "rimraf ./dist && tsc && node buildInfo.js",
    "start": "NODE_ENV=production node dist/app.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "rimraf": "^5.0.7",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "engines": { "node": ">=18" }
}
